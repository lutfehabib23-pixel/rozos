# rozOS C reference - <unistd.h> (phase 19b)
# POSIX: files by number (file descriptors), processes, the current
# directory and small system questions. Not part of ISO C, but every
# rozOS program can use it.

@entry read
@also ssize_t STDIN_FILENO
@header unistd.h
@syntax ssize_t read(int fd, void *buf, size_t count);
@summary Read up to count bytes from an open file descriptor.
@desc
The low-level partner of fread. fd is a small number from open, pipe,
socket or dup; 0 is standard input (STDIN_FILENO), 1 standard output,
2 standard error. read may return fewer bytes than asked (a terminal gives
one line, a pipe gives what is there) - loop if you need exactly count.
A return of 0 means end of file.
@returns
Bytes read (0 at end of file), or -1 with errno set.
@see write open close fread lseek
@example
#include <stdio.h>
#include <unistd.h>
#include <fcntl.h>

int main(void)
{
    char buf[64];
    ssize_t n;
    int fd = open("demo.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);
    write(fd, "hello from read()\n", 18);
    close(fd);

    fd = open("demo.txt", O_RDONLY);
    if (fd < 0) { perror("open"); return 1; }
    while ((n = read(fd, buf, sizeof buf)) > 0)
        write(STDOUT_FILENO, buf, (size_t)n);
    close(fd);
    return 0;
}
@end

@entry write
@also STDOUT_FILENO STDERR_FILENO
@header unistd.h
@syntax ssize_t write(int fd, const void *buf, size_t count);
@summary Write count bytes to an open file descriptor.
@desc
No buffering: the bytes go straight to the kernel, so mixing write(1, ...)
with printf can give mixed-up order unless you fflush(stdout) first.
Writing to a pipe or socket may write less than count; loop over the rest.
@returns
Bytes written, or -1 with errno set (EPIPE when nobody reads a pipe).
@see read open fwrite
@example
#include <string.h>
#include <unistd.h>

static int write_all(int fd, const char *s)
{
    size_t left = strlen(s);
    while (left > 0) {
        ssize_t n = write(fd, s, left);
        if (n < 0) return -1;
        s += n;
        left -= (size_t)n;
    }
    return 0;
}

int main(void)
{
    write_all(STDOUT_FILENO, "to standard output\n");
    write_all(STDERR_FILENO, "to standard error\n");
    return 0;
}
@end

@entry close
@header unistd.h
@syntax int close(int fd);
@summary Close a file descriptor so its number can be used again.
@desc
Every open, pipe, socket, accept and dup gives a descriptor that should be
closed when you are done. A process can hold 256 descriptors at once.
Closing the write end of a pipe is how the reader sees end of file.
@returns
0, or -1 with errno set (EBADF for a number that is not open).
@see open read write
@example
#include <stdio.h>
#include <unistd.h>
#include <fcntl.h>

int main(void)
{
    int fd = open("x.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);
    printf("open gave %d\n", fd);
    printf("close: %d\n", close(fd));
    printf("close again: %d (already closed)\n", close(fd));
    return 0;
}
@end

@entry lseek
@also off_t
@header unistd.h
@syntax off_t lseek(int fd, off_t offset, int whence);
@summary Move the read/write position of a file descriptor.
@desc
whence is SEEK_SET (from the start), SEEK_CUR (from here) or SEEK_END
(from the end). lseek(fd, 0, SEEK_END) gives the file size. Pipes,
sockets and terminals cannot seek (ESPIPE).
@returns
The new position from the start of the file, or -1.
@see read write fseek pread
@example
#include <stdio.h>
#include <unistd.h>
#include <fcntl.h>

int main(void)
{
    char c;
    int fd = open("abc.txt", O_RDWR | O_CREAT | O_TRUNC, 0644);
    write(fd, "ABCDEFGHIJ", 10);
    printf("size = %ld\n", (long)lseek(fd, 0, SEEK_END));
    lseek(fd, 4, SEEK_SET);
    read(fd, &c, 1);
    printf("byte 4 = %c\n", c);
    close(fd);
    return 0;
}
@end

@entry pread
@also pwrite
@header unistd.h
@syntax ssize_t pread(int fd, void *buf, size_t count, off_t offset);
@syntax ssize_t pwrite(int fd, const void *buf, size_t count, off_t offset);
@summary Read or write at a given offset without moving the file position.
@desc
Like lseek + read, but in one call and the current position stays where it
was. Handy for files used like a table of fixed-size records, and safe
when several threads share one descriptor.
@returns
Bytes read or written, or -1.
@see read write lseek readv
@example
#include <stdio.h>
#include <unistd.h>
#include <fcntl.h>

int main(void)
{
    char rec[4] = {0};
    int fd = open("table.dat", O_RDWR | O_CREAT | O_TRUNC, 0644);
    pwrite(fd, "AAA", 3, 0);
    pwrite(fd, "BBB", 3, 3);
    pwrite(fd, "CCC", 3, 6);
    pread(fd, rec, 3, 3);                 /* record number 1 */
    printf("record 1 = %s, position still %ld\n", rec, (long)lseek(fd, 0, SEEK_CUR));
    close(fd);
    return 0;
}
@end

@entry dup
@also dup2
@header unistd.h
@syntax int dup(int fd);
@syntax int dup2(int fd, int newfd);
@summary Copy a file descriptor (dup2: onto a chosen number).
@desc
Both numbers then refer to the same open file and share its position.
dup2(fd, 1) makes standard output go to fd - the trick a shell uses for
"cmd > file". If newfd was open it is closed first.
@returns
The new descriptor, or -1.
@see open close pipe fork execvp
@example
#include <stdio.h>
#include <unistd.h>
#include <fcntl.h>

int main(void)
{
    int saved = dup(STDOUT_FILENO);
    int fd = open("out.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);
    char buf[64];
    ssize_t n;

    fflush(stdout);
    dup2(fd, STDOUT_FILENO);              /* stdout -> out.txt */
    printf("this line goes into the file\n");
    fflush(stdout);
    dup2(saved, STDOUT_FILENO);           /* back to the screen */
    close(saved);
    close(fd);

    fd = open("out.txt", O_RDONLY);
    n = read(fd, buf, sizeof buf - 1);
    buf[n > 0 ? n : 0] = '\0';
    printf("file holds: %s", buf);
    close(fd);
    return 0;
}
@end

@entry pipe
@also pipe2
@header unistd.h
@syntax int pipe(int fds[2]);
@syntax int pipe2(int fds[2], int flags);
@summary Make a one-way channel: write into fds[1], read from fds[0].
@desc
Usually followed by fork, so one process writes and the other reads. The
reader sees end of file once every copy of the write end is closed - so
close the end you do not use. pipe2 also takes O_NONBLOCK and O_CLOEXEC.
A pipe holds a few KiB; a writer waits when it is full.
@returns
0, or -1.
@see fork dup read write popen
@example
#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <sys/wait.h>

int main(void)
{
    int fds[2];
    char buf[64];
    ssize_t n;
    if (pipe(fds) < 0) { perror("pipe"); return 1; }
    if (fork() == 0) {                    /* child: writer */
        const char *msg = "hello through the pipe";
        close(fds[0]);
        write(fds[1], msg, strlen(msg));
        close(fds[1]);
        _exit(0);
    }
    close(fds[1]);                        /* parent: reader */
    n = read(fds[0], buf, sizeof buf - 1);
    buf[n > 0 ? n : 0] = '\0';
    printf("parent got: %s\n", buf);
    close(fds[0]);
    wait(NULL);
    return 0;
}
@end

@entry fork
@also _exit pid_t
@header unistd.h
@syntax pid_t fork(void);
@summary Make a copy of the running process.
@desc
After fork two processes run the same code. In the child fork returns 0;
in the parent it returns the child's process id. Memory is copied (copy on
write), open descriptors are shared. A child usually calls execvp to run
another program, or does its job and leaves with _exit (which skips the
parent's stdio buffers and atexit functions). The parent should collect
the child with waitpid, or it stays as a "zombie".
@returns
0 in the child, the child's pid in the parent, -1 on failure.
@see execvp waitpid pipe getpid
@example
#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main(void)
{
    int status;
    pid_t pid = fork();
    if (pid < 0) { perror("fork"); return 1; }
    if (pid == 0) {
        printf("child: my pid is %d\n", (int)getpid());
        fflush(stdout);                   /* _exit does not flush stdio */
        _exit(7);
    }
    waitpid(pid, &status, 0);
    printf("parent: child %d ended with %d\n", (int)pid, WEXITSTATUS(status));
    return 0;
}
@end

@entry execvp
@also exec execl execle execlp execv execve execvpe
@header unistd.h
@syntax int execvp(const char *file, char *const argv[]);
@syntax int execv(const char *path, char *const argv[]);
@syntax int execve(const char *path, char *const argv[], char *const envp[]);
@syntax int execvpe(const char *file, char *const argv[], char *const envp[]);
@syntax int execl(const char *path, const char *arg0, ... /* NULL */);
@syntax int execlp(const char *file, const char *arg0, ... /* NULL */);
@syntax int execle(const char *path, const char *arg0, ... /* NULL, envp */);
@summary Replace the running program with another one.
@desc
The exec family never returns on success: the new program takes over the
process (same pid, same open descriptors). Letters in the name:
  v  arguments as an array ending in NULL
  l  arguments as a list ending in NULL
  p  search the PATH for file (like the shell does)
  e  give the environment yourself (otherwise environ is used)
argv[0] is the program name by tradition. Usually used after fork.
@returns
Only on failure: -1 with errno (ENOENT: no such program).
@see fork waitpid system
@example
#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main(void)
{
    int status;
    pid_t pid = fork();
    if (pid == 0) {
        char *args[] = { "echo", "hello", "from", "echo", NULL };
        execvp("echo", args);
        perror("execvp");                 /* only reached on failure */
        _exit(127);
    }
    waitpid(pid, &status, 0);
    printf("echo finished with %d\n", WEXITSTATUS(status));
    return 0;
}
@end

@entry getpid
@also getppid gettid
@header unistd.h
@syntax pid_t getpid(void);
@syntax pid_t getppid(void);
@syntax pid_t gettid(void);
@summary The process id of this process, of its parent, of this thread.
@desc
The number the system uses for the process (see ps). getppid gives the
parent (the shell, for a program started from rozsh). gettid gives the id
of the calling thread; in the main thread it equals getpid.
@returns
The id; these calls cannot fail.
@see fork kill pthread_self
@example
#include <stdio.h>
#include <unistd.h>

int main(void)
{
    printf("pid %d, parent %d, thread %d\n", (int)getpid(), (int)getppid(), (int)gettid());
    return 0;
}
@end

@entry getuid
@also geteuid getgid getegid setuid setgid seteuid setegid getgroups getlogin getlogin_r uid_t gid_t
@header unistd.h
@syntax uid_t getuid(void);       uid_t geteuid(void);
@syntax gid_t getgid(void);       gid_t getegid(void);
@syntax int setuid(uid_t uid);    int setgid(gid_t gid);
@syntax int seteuid(uid_t uid);   int setegid(gid_t gid);
@syntax int getgroups(int size, gid_t list[]);
@syntax char *getlogin(void);     int getlogin_r(char *buf, size_t size);
@summary User and group ids of the process.
@desc
rozOS has one user, root (id 0, see /etc/passwd), so the get calls give 0
and getgroups gives one group, 0. setuid(0) and friends succeed; any other
id fails with EPERM. getlogin gives $USER (or $LOGNAME, or the name of
user 0). The calls exist so programs written for other systems build and
run unchanged.
@returns
The id; set calls 0 or -1; getlogin a name or NULL.
@see getpwuid getpid
@example
#include <stdio.h>
#include <unistd.h>

int main(void)
{
    gid_t groups[8];
    int n = getgroups(8, groups);
    printf("uid %d, gid %d, %d group(s)\n", (int)getuid(), (int)getgid(), n);
    printf("setuid(0) = %d\n", setuid(0));
    printf("setuid(1000) = %d (only root exists)\n", setuid(1000));
    return 0;
}
@end

@entry access
@also F_OK R_OK W_OK X_OK
@header unistd.h
@syntax int access(const char *path, int mode);
@summary Check whether a file exists (and may be used).
@desc
mode is F_OK (exists) or a mix of R_OK, W_OK, X_OK. In rozOS everything
runs as root, so the check is "does it exist" for every mode.
@returns
0 if allowed, -1 (errno ENOENT) if not.
@see stat open
@example
#include <stdio.h>
#include <unistd.h>

int main(void)
{
    const char *files[] = { "/", "/no/such/file" };
    int i;
    for (i = 0; i < 2; i++)
        printf("%-14s %s\n", files[i], access(files[i], F_OK) == 0 ? "exists" : "missing");
    return 0;
}
@end

@entry getcwd
@also chdir fchdir
@header unistd.h
@syntax char *getcwd(char *buf, size_t size);
@syntax int chdir(const char *path);
@syntax int fchdir(int fd);
@summary Get or change the current directory.
@desc
Relative paths ("notes.txt", "../src") start from the current directory.
Each process has its own; a child started with fork inherits it, which is
why "cd" must be built into the shell. fchdir is not supported in rozOS
(ENOSYS); keep the path and use chdir instead.
@returns
getcwd: buf, or NULL if size is too small (ERANGE). chdir: 0 or -1.
@see mkdir opendir
@example
#include <stdio.h>
#include <unistd.h>

int main(void)
{
    char dir[256];
    printf("start:  %s\n", getcwd(dir, sizeof dir));
    if (chdir("/") == 0)
        printf("now:    %s\n", getcwd(dir, sizeof dir));
    return 0;
}
@end

@entry unlink
@also rmdir
@header unistd.h
@syntax int unlink(const char *path);
@syntax int rmdir(const char *path);
@summary Delete a file (unlink) or an empty directory (rmdir).
@desc
remove() from stdio.h does either. rmdir fails with ENOTEMPTY while the
directory still holds files.
@returns
0, or -1.
@see remove mkdir
@example
#include <stdio.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/stat.h>

int main(void)
{
    mkdir("box", 0755);
    close(open("box/f.txt", O_WRONLY | O_CREAT, 0644));
    printf("rmdir full box: %d\n", rmdir("box"));
    printf("unlink file:    %d\n", unlink("box/f.txt"));
    printf("rmdir empty:    %d\n", rmdir("box"));
    return 0;
}
@end

@entry link
@also symlink readlink
@header unistd.h
@syntax int link(const char *old, const char *new);
@syntax int symlink(const char *target, const char *linkpath);
@syntax ssize_t readlink(const char *path, char *buf, size_t size);
@summary Hard and symbolic links (not supported by rozOS file systems).
@desc
rozOS file systems have no links: link and symlink fail with EPERM, and
readlink says EINVAL ("not a link") for a file that exists. Programs that
try a link and fall back to copying work fine.
@returns
-1 with errno, in rozOS.
@see rename unlink
@example
#include <stdio.h>
#include <errno.h>
#include <string.h>
#include <unistd.h>

int main(void)
{
    char buf[64];
    if (symlink("/etc/motd", "motd-link") < 0)
        printf("symlink: %s\n", strerror(errno));
    if (readlink("/", buf, sizeof buf) < 0)
        printf("readlink /: %s\n", strerror(errno));
    return 0;
}
@end

@entry chown
@also fchown lchown
@header unistd.h
@syntax int chown(const char *path, uid_t owner, gid_t group);
@syntax int fchown(int fd, uid_t owner, gid_t group);
@syntax int lchown(const char *path, uid_t owner, gid_t group);
@summary Change the owner of a file (nothing to do in rozOS).
@desc
With only one user every file belongs to root. These calls only check
that the file (or descriptor) exists and then succeed.
@returns
0, or -1 if the file does not exist.
@see chmod getuid
@example
#include <stdio.h>
#include <unistd.h>

int main(void)
{
    printf("chown /: %d\n", chown("/", 0, 0));
    printf("chown missing: %d\n", chown("/nope", 0, 0));
    return 0;
}
@end

@entry truncate
@also ftruncate
@header unistd.h
@syntax int truncate(const char *path, off_t length);
@syntax int ftruncate(int fd, off_t length);
@summary Cut a file to length bytes (or grow it with zero bytes).
@desc
ftruncate is also used to give a shared memory object its size (see
shm_open).
@returns
0, or -1.
@see open stat shm_open
@example
#include <stdio.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/stat.h>

int main(void)
{
    struct stat st;
    int fd = open("t.txt", O_RDWR | O_CREAT | O_TRUNC, 0644);
    write(fd, "0123456789", 10);
    ftruncate(fd, 4);
    fstat(fd, &st);
    printf("after ftruncate: %ld bytes\n", (long)st.st_size);
    close(fd);
    truncate("t.txt", 100);
    stat("t.txt", &st);
    printf("after truncate:  %ld bytes\n", (long)st.st_size);
    return 0;
}
@end

@entry fsync
@also fdatasync sync
@header unistd.h
@syntax int fsync(int fd);
@syntax int fdatasync(int fd);
@syntax void sync(void);
@summary Push written data of a file down to the disk.
@desc
write only hands data to the kernel; fsync waits until the file's data is
stored on the disk, so it survives a power cut. fdatasync is the same in
rozOS. sync() does nothing in rozOS (each fsync is already complete).
For stdio files call fflush first, then fsync(fileno(f)).
@returns
0, or -1.
@see write fflush
@example
#include <stdio.h>
#include <unistd.h>
#include <fcntl.h>

int main(void)
{
    int fd = open("journal.txt", O_WRONLY | O_CREAT | O_APPEND, 0644);
    write(fd, "important line\n", 15);
    printf("fsync: %d\n", fsync(fd));
    close(fd);
    return 0;
}
@end

@entry isatty
@also ttyname ttyname_r
@header unistd.h
@syntax int isatty(int fd);
@syntax char *ttyname(int fd);
@syntax int ttyname_r(int fd, char *buf, size_t size);
@summary Is this descriptor a terminal?
@desc
Programs use it to print colours only to a screen, not into a file or a
pipe. In rozOS ttyname of a terminal is "/dev/tty".
@returns
isatty: 1 or 0. ttyname: a name or NULL. ttyname_r: 0 or an error number.
@see tcgetattr
@example
#include <stdio.h>
#include <unistd.h>

int main(void)
{
    int fd;
    for (fd = 0; fd <= 2; fd++)
        printf("fd %d: %s\n", fd, isatty(fd) ? "terminal" : "file or pipe");
    return 0;
}
@end

@entry sleep
@also usleep
@header unistd.h
@syntax unsigned sleep(unsigned seconds);
@syntax int usleep(useconds_t microseconds);
@summary Wait a number of seconds (sleep) or microseconds (usleep).
@desc
The process uses no CPU while it waits. A signal can wake it early. For
nanoseconds use nanosleep from time.h.
@returns
sleep: seconds still left (0 normally). usleep: 0 or -1.
@see nanosleep alarm
@example
#include <stdio.h>
#include <unistd.h>

int main(void)
{
    int i;
    for (i = 3; i > 0; i--) {
        printf("%d...\n", i);
        fflush(stdout);
        usleep(200000);                    /* 0.2 s */
    }
    printf("go!\n");
    return 0;
}
@end

@entry alarm
@also pause
@header unistd.h
@syntax unsigned alarm(unsigned seconds);
@syntax int pause(void);
@summary Get SIGALRM after some seconds; wait for any signal.
@desc
alarm(n) asks the kernel to send SIGALRM in n seconds (alarm(0) cancels).
Without a handler SIGALRM ends the program - a simple time limit. pause
sleeps until a signal arrives and its handler returns.
@returns
alarm: seconds left of the previous alarm. pause: always -1 (EINTR).
@see signal setitimer sigaction
@example
#include <stdio.h>
#include <signal.h>
#include <unistd.h>

static volatile sig_atomic_t rang;

static void on_alarm(int sig) { (void)sig; rang = 1; }

int main(void)
{
    signal(SIGALRM, on_alarm);
    alarm(1);
    printf("waiting for the alarm...\n");
    fflush(stdout);
    while (!rang) pause();
    printf("ring!\n");
    return 0;
}
@end

@entry sysconf
@also pathconf fpathconf getpagesize getdtablesize _SC_PAGESIZE _SC_OPEN_MAX
@header unistd.h
@syntax long sysconf(int name);
@syntax long pathconf(const char *path, int name);
@syntax long fpathconf(int fd, int name);
@syntax int getpagesize(void);
@syntax int getdtablesize(void);
@summary Ask the system about limits and sizes.
@desc
Common names: _SC_PAGESIZE (4096), _SC_OPEN_MAX (256 descriptors),
_SC_CLK_TCK, _SC_NPROCESSORS_ONLN. pathconf names: _PC_NAME_MAX,
_PC_PATH_MAX. getpagesize and getdtablesize are old short forms.
@returns
The value, or -1 if the name is unknown.
@see getrlimit
@example
#include <stdio.h>
#include <unistd.h>

int main(void)
{
    printf("page size  %ld\n", sysconf(_SC_PAGESIZE));
    printf("open max   %ld\n", sysconf(_SC_OPEN_MAX));
    printf("clock tick %ld\n", sysconf(_SC_CLK_TCK));
    printf("name max   %ld\n", pathconf("/", _PC_NAME_MAX));
    return 0;
}
@end

@entry gethostname
@also sethostname gethostid
@header unistd.h
@syntax int gethostname(char *name, size_t len);
@syntax int sethostname(const char *name, size_t len);
@syntax long gethostid(void);
@summary The computer's name.
@desc
rozOS reads the name from /etc/hostname (edit that file to rename the
computer); sethostname is refused with EPERM. uname gives the same name
plus the system version.
@returns
0 or -1; gethostid a number.
@see uname
@example
#include <stdio.h>
#include <unistd.h>

int main(void)
{
    char name[64];
    if (gethostname(name, sizeof name) == 0)
        printf("this computer is called %s\n", name);
    return 0;
}
@end

@entry setpgid
@also getpgid getpgrp setsid getsid
@header unistd.h
@syntax int setpgid(pid_t pid, pid_t pgid);
@syntax pid_t getpgid(pid_t pid);
@syntax pid_t getpgrp(void);
@syntax pid_t setsid(void);
@syntax pid_t getsid(pid_t pid);
@summary Process groups and sessions.
@desc
A process group is a set of processes (a pipeline) that receive keyboard
signals together; kill(-pgid, sig) or killpg signals the whole group. A
session is a set of groups attached to one terminal. setsid starts a new
session (used by daemons and terminal programs). pid 0 means "me".
@returns
The id, or 0 / -1 for the set calls.
@see kill tcsetpgrp fork
@example
#include <stdio.h>
#include <unistd.h>

int main(void)
{
    printf("pid %d, group %d, session %d\n", (int)getpid(), (int)getpgrp(), (int)getsid(0));
    if (setpgid(0, 0) == 0)
        printf("now leader of my own group %d\n", (int)getpgrp());
    return 0;
}
@end

@entry nice
@header unistd.h
@syntax int nice(int inc);
@summary Ask for a lower (or higher) scheduling priority.
@desc
Accepted but has no effect in rozOS: every process gets the same share of
the CPU.
@returns
0.
@see sched_yield setpriority
@example
#include <stdio.h>
#include <unistd.h>

int main(void)
{
    printf("nice(5) = %d\n", nice(5));
    return 0;
}
@end

@entry sbrk
@also brk
@header unistd.h
@syntax void *sbrk(long increment);
@syntax int brk(void *addr);
@summary Grow or shrink the program's data area directly.
@desc
The oldest way to get memory; malloc does this for you and is almost
always the better choice. sbrk(0) tells where the data area ends now.
Do not mix your own brk use with malloc.
@returns
sbrk: the old end, or (void *)-1. brk: 0 or -1.
@see malloc mmap
@example
#include <stdio.h>
#include <unistd.h>

int main(void)
{
    char *before = sbrk(0);
    char *p = sbrk(4096);
    char *after = sbrk(0);
    if (p == (void *)-1) return 1;
    p[0] = 'x';
    printf("grew the data area by %ld bytes\n", (long)(after - before));
    return 0;
}
@end

@entry getpass
@header unistd.h
@syntax char *getpass(const char *prompt);
@summary Read a password from the terminal without showing it.
@desc
Prints prompt on standard error, turns echo off while the line is typed,
then turns it back on. The text (up to 127 characters, without the
newline) is in a static buffer that the next call overwrites.
@returns
The text, or NULL.
@see tcsetattr fgets
@check compile
@example
#include <stdio.h>
#include <string.h>
#include <unistd.h>

int main(void)
{
    char *pw = getpass("Password: ");
    if (pw && strcmp(pw, "rozos") == 0) printf("welcome\n");
    else printf("wrong password\n");
    return 0;
}
@end

@entry flock
@also lockf LOCK_SH LOCK_EX LOCK_UN
@header sys/file.h
@syntax int flock(int fd, int operation);      /* <sys/file.h> */
@syntax int lockf(int fd, int cmd, off_t len); /* <unistd.h> */
@summary Lock a file against other processes (accepted, no effect in rozOS).
@desc
rozOS does not keep file locks yet: both calls check that fd is open and
succeed. Programs that use locks to protect a file still run correctly as
long as only one copy runs at a time.
@returns
0, or -1 for a bad descriptor.
@see fcntl open
@example
#include <stdio.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/file.h>

int main(void)
{
    int fd = open("lock.txt", O_WRONLY | O_CREAT, 0644);
    printf("flock: %d\n", flock(fd, LOCK_EX));
    printf("lockf: %d\n", lockf(fd, F_LOCK, 0));
    flock(fd, LOCK_UN);
    close(fd);
    return 0;
}
@end
