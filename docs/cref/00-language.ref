# rozOS C reference - the C language (phase 19a)
# Format: see userland/lib/rozcref.h. Every example is compiled and run by `make cref-check`.

@entry hello
@also program main
@header language
@summary The first C program: how a program is built and where it starts.
@desc
Every C program starts in the function main(). #include lines bring in the
declarations of library functions (here printf from <stdio.h>). main returns
an int to the system: 0 means "all went well".

Build and run it in rozOS:
    tcc hello.c -o hello
    ./hello
In Code press F5; in edit press Ctrl+R.
@see comments types printf functions main-args
@example
#include <stdio.h>

int main(void)
{
    printf("Hello from rozOS!\n");
    return 0;
}
@end

@entry comments
@also /* //
@header language
@summary Notes in the source that the compiler ignores.
@desc
/* ... */ can span many lines; // runs to the end of the line (C99).
Comments cannot be nested: /* a /* b */ ends at the first */.
@see hello preprocessor
@example
#include <stdio.h>

/* This program shows both kinds of comments.
   They can be as long as you like. */
int main(void)
{
    int apples = 3;   // a comment to the end of the line
    printf("%d apples\n", apples);
    return 0;
}
@end

@entry types
@also char short int long float double signed unsigned _Bool bool data-types
@header language
@summary The basic data types and their sizes on rozOS (x86_64).
@desc
  type                size   range (on rozOS x86_64)
  char                1      -128 .. 127
  unsigned char       1      0 .. 255
  short               2      -32768 .. 32767
  unsigned short      2      0 .. 65535
  int                 4      -2147483648 .. 2147483647
  unsigned int        4      0 .. 4294967295
  long, long long     8      about -9.2e18 .. 9.2e18
  unsigned long       8      0 .. 18446744073709551615
  float               4      about 7 digits, up to 3.4e38
  double              8      about 15 digits, up to 1.8e308
  long double         16     about 18 digits (x87 80-bit)
  pointer (any)       8
  _Bool / bool        1      0 or 1 (bool needs <stdbool.h>)

Integers are signed unless you write unsigned. Exact sizes: <stdint.h>
(int32_t, uint8_t ...). Limits as constants: <limits.h>, <float.h>.
@see sizeof limits stdint variables casts
@example
#include <stdio.h>
#include <stdbool.h>

int main(void)
{
    char c = 'A';
    int i = 42;
    long big = 9000000000L;
    double d = 3.14159;
    bool ok = true;
    printf("char %c is %d\n", c, c);
    printf("int %d, long %ld, double %.2f, bool %d\n", i, big, d, ok);
    printf("sizes: int %zu, long %zu, double %zu, pointer %zu\n",
           sizeof(int), sizeof(long), sizeof(double), sizeof(void *));
    return 0;
}
@end

@entry variables
@also scope declaration initialization
@header language
@summary Declaring variables, giving them values, and where they can be used.
@desc
  type name;            declare
  type name = value;    declare and initialise
  int a = 1, b = 2;     several at once
A variable declared inside { } exists only in that block (local scope).
Declared outside all functions it is global: every function can use it,
and it starts as 0. Local variables are NOT set to 0 - give them a value
before you read them.
@see types constants storage functions
@example
#include <stdio.h>

int counter;                 /* global: starts at 0 */

static void add(int n)
{
    counter += n;            /* uses the global */
}

int main(void)
{
    int x = 10;              /* local to main */
    {
        int x = 20;          /* a different x, only inside these braces */
        printf("inner x = %d\n", x);
    }
    add(x);
    add(5);
    printf("outer x = %d, counter = %d\n", x, counter);
    return 0;
}
@end

@entry constants
@also const literal literals #define-constant
@header language
@summary Numbers, characters and strings written in the program, and const.
@desc
  42   -7        decimal int          42L  42LL  42U  42UL   long/unsigned
  0x2A           hexadecimal          052                    octal (leading 0!)
  3.14  1e-3     double               3.14f                  float
  'A'  '\n'      a character (an int with the character code)
  "text"         a string: an array of char ending with '\0'
const int N = 10;    a variable that cannot be changed
#define N 10         a name the preprocessor replaces with 10
@see types escapes preprocessor strings
@example
#include <stdio.h>

#define DAYS 7

int main(void)
{
    const double PI = 3.14159;
    int hex = 0xFF, oct = 010;
    printf("hex 0xFF = %d, octal 010 = %d\n", hex, oct);
    printf("%d days, pi = %.3f, 'A' = %d\n", DAYS, PI, 'A');
    printf("1e3 = %g, 2.5f = %f\n", 1e3, 2.5f);
    return 0;
}
@end

@entry operators
@also precedence operator + - * / % == != && || ! ?: ++ -- << >>
@header language
@summary All C operators, from highest to lowest priority.
@desc
  ()  []  ->  .  x++  x--                     left to right
  ++x --x  +x -x  !  ~  *p  &x  (type)  sizeof   right to left
  *  /  %                                      left to right
  +  -
  <<  >>                                       bit shifts
  <  <=  >  >=
  ==  !=
  &                                            bitwise AND
  ^                                            bitwise XOR
  |                                            bitwise OR
  &&                                           logical AND (stops early)
  ||                                           logical OR (stops early)
  ?:                                           cond ? a : b   right to left
  =  +=  -=  *=  /=  %=  <<=  >>=  &=  ^=  |=  right to left
  ,                                            left to right

Integer division drops the fraction: 7 / 2 is 3; 7 % 2 is 1.
Comparisons give 1 (true) or 0 (false). Use parentheses when unsure.
@see if types casts
@example
#include <stdio.h>

int main(void)
{
    int a = 7, b = 2;
    printf("7/2 = %d, 7%%2 = %d, 7.0/2 = %.1f\n", a / b, a % b, 7.0 / 2);
    printf("a > b is %d, a == b is %d\n", a > b, a == b);
    printf("bits: 6 & 3 = %d, 6 | 3 = %d, 6 ^ 3 = %d, 1 << 4 = %d\n", 6 & 3, 6 | 3, 6 ^ 3, 1 << 4);
    printf("bigger is %d\n", a > b ? a : b);
    a += 3;
    printf("a after += 3 is %d\n", a);
    b = a++;                      /* b gets the old value, then a grows */
    printf("b = a++ gives b = %d, a = %d\n", b, a);
    return 0;
}
@end

@entry if
@also else
@header language
@summary Do something only when a condition is true.
@desc
  if (condition) statement
  if (condition) { ... } else if (other) { ... } else { ... }
The condition is true when it is not 0. A common mistake is = instead
of ==:  if (x = 5)  sets x and is always true.
@see switch operators for
@example
#include <stdio.h>

int main(void)
{
    int marks[] = { 95, 72, 40, 15 };
    int i;
    for (i = 0; i < 4; i++) {
        int m = marks[i];
        if (m >= 80)
            printf("%d: A\n", m);
        else if (m >= 60)
            printf("%d: B\n", m);
        else if (m >= 33)
            printf("%d: pass\n", m);
        else
            printf("%d: fail\n", m);
    }
    return 0;
}
@end

@entry switch
@also case default
@header language
@summary Choose one of many branches by the value of an integer.
@desc
  switch (expression) {
  case 1:  ...; break;
  case 2:
  case 3:  ...; break;     two cases share the code
  default: ...;            when no case matches
  }
Without break the program "falls through" into the next case.
Case labels must be constant integers (or characters like 'a').
@see if break enum
@example
#include <stdio.h>

int main(void)
{
    const char *cmds = "aqxs";
    int i;
    for (i = 0; cmds[i]; i++) {
        switch (cmds[i]) {
        case 'a':
            printf("add\n");
            break;
        case 's':
            printf("save\n");
            break;
        case 'q':
        case 'x':
            printf("quit\n");
            break;
        default:
            printf("unknown\n");
        }
    }
    return 0;
}
@end

@entry for
@header language
@summary The counting loop: start; condition; step.
@desc
  for (start; condition; step) statement
  for (int i = 0; i < 10; i++) { ... }     (C99: i lives only in the loop)
Any part can be empty: for (;;) loops forever (stop it with break).
@see while break arrays
@example
#include <stdio.h>

int main(void)
{
    int i, j, sum = 0;
    for (i = 1; i <= 10; i++)
        sum += i;
    printf("1 + 2 + ... + 10 = %d\n", sum);
    for (i = 1; i <= 3; i++) {          /* a small multiplication table */
        for (j = 1; j <= 5; j++)
            printf("%4d", i * j);
        printf("\n");
    }
    return 0;
}
@end

@entry while
@also do do-while
@header language
@summary Repeat while a condition stays true.
@desc
  while (condition) statement        checks first - may run 0 times
  do statement while (condition);    runs at least once
@see for break
@example
#include <stdio.h>

int main(void)
{
    int n = 1234, digits = 0, k = 0;
    while (n > 0) {
        n /= 10;
        digits++;
    }
    printf("1234 has %d digits\n", digits);
    do {
        printf("this runs once even though k is %d\n", k);
    } while (k > 0);
    return 0;
}
@end

@entry break
@also continue goto label
@header language
@summary Leave a loop early, skip to the next round, or jump.
@desc
break leaves the nearest loop or switch. continue skips the rest of the
loop body and starts the next round. goto label; jumps to "label:" in the
same function - use it rarely, e.g. to leave several loops at once or to
clean up on errors.
@see for while switch
@example
#include <stdio.h>

int main(void)
{
    int i, j;
    for (i = 1; i <= 10; i++) {
        if (i % 2 == 0) continue;      /* skip even numbers */
        if (i > 7) break;              /* stop after 7 */
        printf("%d ", i);
    }
    printf("\n");
    for (i = 0; i < 10; i++)
        for (j = 0; j < 10; j++)
            if (i * j == 42) goto found;
    printf("not found\n");
    return 0;
found:
    printf("found %d * %d = 42\n", i, j);
    return 0;
}
@end

@entry functions
@also function return void prototype recursion parameters
@header language
@summary Write your own functions: parameters, return value, prototypes.
@desc
  return_type name(type param1, type param2) { ...; return value; }
  void name(void)          takes nothing, returns nothing
A function must be declared before it is used: either define it above,
or write a prototype ("int square(int x);") first. Arguments are copied
(passed by value); to change the caller's variable, pass a pointer.
A function may call itself (recursion).
@see pointers variables storage
@example
#include <stdio.h>

int square(int x);                 /* prototype */
static void swap(int *a, int *b);

static long factorial(int n)       /* recursion */
{
    return n <= 1 ? 1 : n * factorial(n - 1);
}

int main(void)
{
    int a = 3, b = 9;
    printf("square(5) = %d\n", square(5));
    printf("10! = %ld\n", factorial(10));
    swap(&a, &b);
    printf("after swap: a = %d, b = %d\n", a, b);
    return 0;
}

int square(int x)
{
    return x * x;
}

static void swap(int *a, int *b)
{
    int t = *a;
    *a = *b;
    *b = t;
}
@end

@entry arrays
@also array []
@header language
@summary A row of values of the same type, numbered from 0.
@desc
  int a[5];                     five ints: a[0] .. a[4]
  int b[] = { 1, 2, 3 };        size taken from the list
  int m[3][4];                  3 rows of 4
The number of elements: sizeof a / sizeof a[0]. C does NOT check the
index: a[5] above writes past the end and corrupts memory. An array
given to a function becomes a pointer to its first element, so pass
the length too.
@see strings pointers for sizeof
@example
#include <stdio.h>

static int sum(const int *v, int n)
{
    int s = 0, i;
    for (i = 0; i < n; i++) s += v[i];
    return s;
}

int main(void)
{
    int a[] = { 4, 8, 15, 16, 23, 42 };
    int n = (int)(sizeof a / sizeof a[0]), r, c;
    int grid[2][3] = { { 1, 2, 3 }, { 4, 5, 6 } };
    printf("%d numbers, sum %d, last %d\n", n, sum(a, n), a[n - 1]);
    for (r = 0; r < 2; r++) {
        for (c = 0; c < 3; c++) printf("%d ", grid[r][c]);
        printf("\n");
    }
    return 0;
}
@end

@entry strings
@also string char-array \0
@header language
@summary Text in C: arrays of char that end with a '\0' byte.
@desc
  char s[] = "hi";          3 bytes: 'h' 'i' '\0'
  char buf[64];             room for 63 characters + '\0'
  const char *p = "text";   points to text that must not be changed
Strings cannot be copied or compared with = and ==; use strcpy (or the
safer snprintf / strlcpy) and strcmp from <string.h>. Always leave room
for the final '\0'.
@see arrays strlen strcpy strcmp snprintf strcat
@example
#include <stdio.h>
#include <string.h>

int main(void)
{
    char name[32] = "rozOS";
    char greeting[64];
    int i;
    snprintf(greeting, sizeof greeting, "Hello, %s!", name);
    printf("%s (%zu letters)\n", greeting, strlen(greeting));
    for (i = 0; name[i] != '\0'; i++)
        printf("[%c]", name[i]);
    printf("\n");
    if (strcmp(name, "rozOS") == 0) printf("same text\n");
    return 0;
}
@end

@entry pointers
@also pointer & NULL address pointer-arithmetic
@header language
@summary Variables that hold the address of other data.
@desc
  int x = 5;
  int *p = &x;     p holds the address of x
  *p = 7;          change x through p
  p = NULL;        points nowhere (reading *p then crashes the program)
p + 1 points to the next element (not the next byte). Pointers let a
function change the caller's variables, walk through arrays, and use
memory from malloc. In rozOS reading or writing a bad address stops the
program with "Page fault ... killed (signal 11)".
@see arrays functions memory struct
@example
#include <stdio.h>

int main(void)
{
    int x = 5, *p = &x;
    int a[] = { 10, 20, 30 }, *q;
    *p = 7;
    printf("x = %d, *p = %d\n", x, *p);
    for (q = a; q < a + 3; q++)          /* walk the array */
        printf("%d at offset %d\n", *q, (int)(q - a));
    p = NULL;
    if (p == NULL) printf("p points nowhere now\n");
    return 0;
}
@end

@entry struct
@also structure -> . member
@header language
@summary Group several values of different types into one record.
@desc
  struct point { int x, y; };
  struct point p = { 3, 4 };        p.x is 3
  struct point *pp = &p;            pp->x is the same as (*pp).x
Structs can be copied with = and passed to and returned from functions.
Use typedef to avoid writing "struct" every time.
@see typedef union pointers memory
@example
#include <stdio.h>
#include <string.h>

struct student {
    char name[32];
    int age;
    double marks;
};

static void birthday(struct student *s)
{
    s->age++;
}

int main(void)
{
    struct student s = { "Rahim", 20, 81.5 };
    struct student copy;
    birthday(&s);
    copy = s;
    strcpy(copy.name, "Karim");
    printf("%s is %d, marks %.1f\n", s.name, s.age, s.marks);
    printf("%s is %d\n", copy.name, copy.age);
    return 0;
}
@end

@entry union
@header language
@summary Several members that share the same memory.
@desc
A union is as big as its largest member; writing one member and reading
another reinterprets the same bytes. Often used together with a "tag"
that says which member is valid.
@see struct enum
@example
#include <stdio.h>

struct value {
    int kind;                  /* 0 = int, 1 = double */
    union {
        int i;
        double d;
    } u;
};

static void show(struct value v)
{
    if (v.kind == 0) printf("int %d\n", v.u.i);
    else printf("double %g\n", v.u.d);
}

int main(void)
{
    struct value a, b;
    a.kind = 0; a.u.i = 42;
    b.kind = 1; b.u.d = 2.5;
    show(a);
    show(b);
    printf("size of the union: %zu\n", sizeof a.u);
    return 0;
}
@end

@entry enum
@also enumeration
@header language
@summary Named integer constants.
@desc
  enum color { RED, GREEN, BLUE };          RED = 0, GREEN = 1, BLUE = 2
  enum { KB = 1024, MB = KB * 1024 };       values can be given
Good with switch and for flags.
@see switch typedef constants
@example
#include <stdio.h>

enum day { MON = 1, TUE, WED, THU, FRI, SAT, SUN };

int main(void)
{
    enum day d;
    for (d = MON; d <= SUN; d++)
        printf("%d%s", d, d == SAT || d == SUN ? " (weekend)\n" : "\n");
    return 0;
}
@end

@entry typedef
@header language
@summary Give a type a new (shorter) name.
@desc
  typedef unsigned char byte;
  typedef struct { int x, y; } point;      now write "point p;"
  typedef int (*compare_fn)(int, int);     a name for a function pointer
@see struct enum pointers
@example
#include <stdio.h>

typedef unsigned char byte;
typedef struct { double x, y; } vec2;
typedef double (*binop)(double, double);

static double add(double a, double b) { return a + b; }
static double mul(double a, double b) { return a * b; }

int main(void)
{
    byte b = 200;
    vec2 v = { 1.5, 2.0 };
    binop ops[2] = { add, mul };
    printf("byte %u, vec (%.1f, %.1f)\n", b, v.x, v.y);
    printf("add %.1f, mul %.1f\n", ops[0](v.x, v.y), ops[1](v.x, v.y));
    return 0;
}
@end

@entry sizeof
@header language
@summary The size of a type or variable in bytes (decided while compiling).
@desc
  sizeof(type)    sizeof variable    - the result is a size_t (print with %zu)
sizeof array / sizeof array[0] gives the number of elements - but only
for a real array, not for a pointer a function received.
@see types arrays malloc
@example
#include <stdio.h>

struct rec { char c; int i; double d; };

int main(void)
{
    int a[10];
    printf("int %zu, double %zu, struct rec %zu (with padding)\n",
           sizeof(int), sizeof(double), sizeof(struct rec));
    printf("array: %zu bytes, %zu elements\n", sizeof a, sizeof a / sizeof a[0]);
    return 0;
}
@end

@entry casts
@also cast conversion type-conversion
@header language
@summary Convert a value to another type: (type)value.
@desc
In mixed arithmetic C converts automatically (int + double -> double).
A cast forces it: (double)a / b divides as doubles. Converting a double
to int cuts off the fraction (3.9 becomes 3). void * from malloc
converts to any pointer type.
@see types operators
@example
#include <stdio.h>

int main(void)
{
    int a = 7, b = 2;
    double avg = (double)(a + b) / 2;
    printf("int division %d, with cast %.2f\n", a / b, (double)a / b);
    printf("average %.1f, (int)3.9 = %d, (char)65 = %c\n", avg, (int)3.9, (char)65);
    return 0;
}
@end

@entry preprocessor
@also #include #define #if #ifdef #ifndef #endif macro macros
@header language
@summary Commands run before compiling: include files, macros, conditions.
@desc
  #include <stdio.h>      a system header (/usr/include)
  #include "my.h"         a header in your folder
  #define SIZE 100        replace SIZE with 100
  #define SQ(x) ((x) * (x))   a macro with an argument (use parentheses!)
  #ifdef DEBUG ... #endif     compile a part only if DEBUG is defined
  #if X > 2 ... #elif ... #else ... #endif
  __FILE__ __LINE__ __func__   where you are
Define on the command line: tcc -DDEBUG prog.c
@see constants hello
@example
#include <stdio.h>

#define SQ(x) ((x) * (x))
#define DEBUG 1

int main(void)
{
    printf("SQ(4) = %d, SQ(1 + 2) = %d\n", SQ(4), SQ(1 + 2));
#if DEBUG
    printf("debug: line %d of %s, in %s()\n", __LINE__, __FILE__, __func__);
#endif
#ifdef __TINYC__
    printf("compiled with tcc\n");
#else
    printf("compiled with another compiler\n");
#endif
    return 0;
}
@end

@entry storage
@also static extern auto register volatile storage-class
@header language
@summary static, extern, register, volatile - where variables live.
@desc
  static int n;     inside a function: keeps its value between calls
                    outside: visible only in this .c file
  extern int n;     "n is defined in another file"
  register int i;   a hint (ignored by modern compilers)
  volatile int f;   may change behind the compiler's back (hardware,
                    signal handlers) - always read it from memory
@see variables functions
@example
#include <stdio.h>

static int next_id(void)
{
    static int id = 100;      /* set once, remembered */
    return id++;
}

int main(void)
{
    int i;
    for (i = 0; i < 3; i++)
        printf("id %d\n", next_id());
    return 0;
}
@end

@entry printf-format
@also format %d %s %f %x conversion-specifiers
@header language
@summary The % codes of printf, sprintf, fprintf ... in one table.
@desc
  %d %i    int                       %u       unsigned int
  %ld %lld long, long long           %zu      size_t     %p  pointer
  %x %X    hexadecimal               %o       octal
  %f       double, 6 decimals        %e %E    1.5e+03 style
  %g       shortest of %f and %e     %a       hexadecimal float
  %c       a character               %s       a string
  %%       a % sign                  %n       store the count so far
Between % and the letter:
  width    %5d (right in 5 places)   %-5d (left)   %05d (zeros)
  .prec    %.2f (2 decimals)  %.3s (at most 3 chars)  %*d (width from argument)
  flags    + (always sign)  space  # (0x prefix, keep the dot)
  sizes    hh h l ll z j t L         (L for long double: %Lf)
@see printf scanf-format escapes
@example
#include <stdio.h>

int main(void)
{
    printf("[%5d] [%-5d] [%05d] [%+d]\n", 42, 42, 42, 42);
    printf("[%x] [%X] [%#x] [%o]\n", 255, 255, 255, 8);
    printf("[%.2f] [%10.3f] [%e] [%g]\n", 3.14159, 3.14159, 12345.678, 0.0001);
    printf("[%c] [%s] [%.3s] [%*d]\n", 'R', "rozOS", "rozOS", 6, 7);
    printf("[%zu] [%lld] [%%]\n", sizeof(long), 123456789012LL);
    return 0;
}
@end

@entry scanf-format
@also %[ scanset
@header language
@summary The % codes of scanf, sscanf, fscanf.
@desc
  %d int*  %u unsigned*  %ld long*  %lld long long*  %x hex  %o octal  %i any base
  %f float*   %lf double*   %Lf long double*        (note: %lf for double!)
  %s a word (stops at space) - give a width: %31s for char buf[32]
  %c one character (does not skip spaces; " %c" does)
  %[a-z] only these characters   %[^\n] everything up to the newline
  %*d read and throw away        %n how many characters so far
Pass the ADDRESS of the variable: scanf("%d", &n). scanf returns how many
values it stored - check it.
@see scanf sscanf printf-format
@example
#include <stdio.h>

int main(void)
{
    int day, year, n;
    char month[16], rest[64];
    double price;
    n = sscanf("23 Nov 2026", "%d %15s %d", &day, month, &year);
    printf("%d values: %d %s %d\n", n, day, month, year);
    sscanf("price: 12.50 taka, paid", "price: %lf %*s %63[^\n]", &price, rest);
    printf("%.2f / '%s'\n", price, rest);
    return 0;
}
@end

@entry escapes
@also escape-sequences \n \t \\ \" newline
@header language
@summary Special characters in character and string constants.
@desc
  \n  new line        \t  tab            \\  backslash
  \"  double quote    \'  single quote   \0  the 0 byte (string end)
  \r  carriage return \a  bell           \b  backspace
  \x41  hex code (A)  \101  octal code (A)
  \033[1;31m  terminal colour codes (rozOS terminals understand them)
@see constants strings printf-format
@example
#include <stdio.h>

int main(void)
{
    printf("Tab:\tafter tab\n");
    printf("Quote: \"hi\", backslash: \\, hex: \x41, octal: \101\n");
    printf("\033[1;32mgreen text\033[0m back to normal\n");
    return 0;
}
@end

@entry main-args
@also argc argv command-line arguments
@header language
@summary Read the words typed after the program name.
@desc
  int main(int argc, char *argv[])
argc is how many words, argv[0] is the program name, argv[1] .. argv[argc-1]
are the arguments (all strings - convert numbers with atoi or strtol).
Example: ./sum 3 4  gives argc 3, argv[1] "3", argv[2] "4".
@see atoi strtol getenv
@example
#include <stdio.h>
#include <stdlib.h>

int main(int argc, char *argv[])
{
    int i, total = 0;
    printf("program: %s, %d argument(s)\n", argv[0], argc - 1);
    for (i = 1; i < argc; i++)
        total += atoi(argv[i]);
    if (argc > 1) printf("sum = %d\n", total);
    else printf("try: ./prog 3 4 5\n");
    return 0;
}
@end

@entry memory
@also dynamic-memory heap allocation
@header language
@summary Getting memory while the program runs: malloc, realloc, free.
@desc
Arrays have a fixed size. When you only know the size at run time, ask
for memory with malloc (or calloc for zeroed memory), grow it with
realloc, and give it back with free when done. Always check for NULL.
Never use memory after free, and never free twice.
@see malloc calloc realloc free pointers
@example
#include <stdio.h>
#include <stdlib.h>

int main(void)
{
    int n = 5, i, *v = malloc(n * sizeof *v);
    if (!v) return 1;
    for (i = 0; i < n; i++) v[i] = i * i;
    v = realloc(v, 2 * n * sizeof *v);          /* grow to 10 */
    if (!v) return 1;
    for (i = n; i < 2 * n; i++) v[i] = i * i;
    for (i = 0; i < 2 * n; i++) printf("%d ", v[i]);
    printf("\n");
    free(v);
    return 0;
}
@end

@entry files
@also file-io file-handling FILE
@header language
@summary Reading and writing files with FILE * (the overview).
@desc
  FILE *f = fopen("name.txt", "w");   "r" read, "w" write (new/empty),
                                      "a" append, add "+" to do both, "b" binary
  fprintf(f, ...); fputs(s, f); fwrite(...);   write
  fgets(buf, size, f); fscanf(f, ...); fread(...); fgetc(f)   read
  fclose(f);                           always close (it also saves)
fopen returns NULL when it fails - check it and print why with perror.
stdin, stdout and stderr are already open.
@see fopen fclose fgets fprintf fread fseek perror
@example
#include <stdio.h>

int main(void)
{
    FILE *f = fopen("notes.txt", "w");
    char line[128];
    int n = 0;
    if (!f) { perror("notes.txt"); return 1; }
    fprintf(f, "first line\nsecond line\n");
    fclose(f);
    f = fopen("notes.txt", "r");
    if (!f) { perror("notes.txt"); return 1; }
    while (fgets(line, sizeof line, f))
        printf("%d: %s", ++n, line);
    fclose(f);
    remove("notes.txt");
    return 0;
}
@end

@entry errors
@also errno error-handling
@header language
@summary How library functions report failure: return value and errno.
@desc
Most functions return a special value on failure (NULL, -1, EOF) and set
the global errno (from <errno.h>) to a code such as ENOENT ("no such
file"). Print the reason with perror("what") or strerror(errno). errno is
only meaningful right after a call failed. Each thread has its own errno.
@see perror strerror exit
@example
#include <stdio.h>
#include <errno.h>
#include <string.h>

int main(void)
{
    FILE *f = fopen("/no/such/file", "r");
    if (!f) {
        printf("errno %d: %s\n", errno, strerror(errno));
        perror("fopen");          /* the same, on stderr */
    }
    return 0;
}
@end

@entry keywords
@also reserved-words
@header language
@summary All C keywords (they cannot be used as names).
@desc
  auto break case char const continue default do double else enum extern
  float for goto if inline int long register restrict return short signed
  sizeof static struct switch typedef union unsigned void volatile while
  _Bool _Complex _Imaginary            (C99)
  _Alignas _Alignof _Noreturn _Static_assert _Generic _Thread_local (C11 -
  partly supported by tcc)
@see types storage hello
@example
#include <stdio.h>

int main(void)
{
    static const char *const kw[] = { "if", "else", "for", "while", "return" };
    unsigned i;
    for (i = 0; i < sizeof kw / sizeof kw[0]; i++)
        printf("%s\n", kw[i]);
    return 0;
}
@end

@entry limits
@also limits.h float.h INT_MAX INT_MIN UINT_MAX LONG_MAX CHAR_BIT DBL_MAX FLT_MAX DBL_EPSILON
@header language
@summary The biggest and smallest values of each type: <limits.h>, <float.h>.
@desc
  INT_MIN INT_MAX UINT_MAX  LONG_MIN LONG_MAX ULONG_MAX  LLONG_MAX
  SHRT_MAX CHAR_MIN CHAR_MAX SCHAR_MAX UCHAR_MAX CHAR_BIT (8)
  FLT_MAX DBL_MAX FLT_MIN DBL_MIN FLT_EPSILON DBL_EPSILON (<float.h>)
Going past INT_MAX with signed arithmetic is undefined - use a bigger
type (long long) or unsigned.
@see types stdint
@example
#include <stdio.h>
#include <limits.h>
#include <float.h>

int main(void)
{
    printf("int: %d .. %d\n", INT_MIN, INT_MAX);
    printf("unsigned int max: %u\n", UINT_MAX);
    printf("long max: %ld\n", LONG_MAX);
    printf("char bits: %d\n", CHAR_BIT);
    printf("double max: %g, epsilon %g\n", DBL_MAX, DBL_EPSILON);
    return 0;
}
@end

@entry stdint
@also stdint.h inttypes.h int8_t int16_t int32_t int64_t uint8_t uint16_t uint32_t uint64_t intptr_t PRId64 PRIu32
@header language
@summary Integers of an exact size, and how to print them.
@desc
  int8_t int16_t int32_t int64_t      signed, exactly 8/16/32/64 bits
  uint8_t ... uint64_t                unsigned
  intptr_t uintptr_t                  big enough for a pointer
  INT32_MAX UINT8_MAX ...             their limits
<inttypes.h> adds printf codes: printf("%" PRId64 "\n", x);
PRIu32, PRIx64 ... and SCNd32 for scanf.
@see types limits printf-format
@example
#include <stdio.h>
#include <stdint.h>
#include <inttypes.h>

int main(void)
{
    uint8_t b = 250;
    int64_t big = INT64_MAX;
    uint32_t mask = 0xDEADBEEF;
    b += 10;                      /* wraps around: 260 - 256 = 4 */
    printf("b = %u\n", (unsigned)b);
    printf("big = %" PRId64 "\n", big);
    printf("mask = 0x%" PRIx32 "\n", mask);
    return 0;
}
@end
